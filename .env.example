# Cloud sync (M7+) — OPTIONAL. Without these, the app is purely local: nothing
# is uploaded, and the sync/sharing UI stays hidden.
#
# Both values are safe to expose in the built, public site: the publishable
# (anon) key is protected by Postgres row-level security, not by being secret.
# In CI they are wired from GitHub Actions repository *variables* (not secrets)
# — see .github/workflows/deploy.yml.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
